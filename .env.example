# Local development defaults to a local Ollama service and gemma4:e2b.
PORT=3000

# MongoDB Atlas connection string. Keep the real value only in your local .env or host secret settings.
# Example format: mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# For hosted deployment, set this in the hosting provider's secret environment settings.
# When this key is present, the server uses Ollama Cloud and defaults to gemma4:31b for the direct cloud API.
OLLAMA_API_KEY=

# Optional overrides:
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_CLOUD_URL=https://ollama.com/api/chat
# OLLAMA_LOCAL_URL=http://127.0.0.1:11434/api/chat
